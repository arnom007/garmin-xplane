  "SupportedAirframes": [
    "SINGLE",
    "MULTI",
    "ROTOR",
    "SINGLETURBO"
  ],
  "SupportedSettings": {
    "taws": {
      "id": "taws",
      "DisplayText": "Terrain Mode",
      "Description": "Determines the terrain mode of the GTN Xi.",
      "DefaultValue": "TAWS_B",
      "UIControl": "PICKLIST",
      "IsDisplayed": true,
      "SupportedValues": {
        "TAWS_B": {
          "DisplayText": "TAWS B",
          "id": "TAWS_B",
          "SwitchValue": "TAWS_B",
          "OptionDescription": "TAWS B",
          "Constraints": [
            {
              "SettingToObserve": "Airframe",
              "DisableOnValues": [
                "ROTOR"
              ]
            }
          ]
        },
        "HTAWS_B": {
          "DisplayText": "TAWS B",
          "id": "HTAWS_B",
          "SwitchValue": "HTAWS_B",
          "OptionDescription": "TAWS B",
          "Constraints": [
            {
              "SettingToObserve": "Airframe",
              "EnableOnValues": [
                "ROTOR"
              ]
            }
          ]
        }
      }
    }
  },
  "DataFormats": {
    "DataRouterClientVersion": "19.2.7.0",
    "Instances": {
      "all": {
        "HSDB": 4,
        "IN": {
          "A429": {
            "0": "GDU"
          },
          "GENERIC": {
            "0": "RDMP"
          }
        },
        "OUT": {
          "A429": {
            "5": "GAMA",
            "6": "NAV"
          },
          "RS232": {
            "0": "MAPMX"
          },
          "GENERIC": {
            "0": "RDMP"
          }
        }
      }
    }
  },
  "Winfs": {
    "Essentials": [
      {
        "Transform": {
          "links": [
            {
              "packagePath": "data\\resource_files.gca",
              "winfs": "sd_card0\\resource_files.gca"
            },
            {
              "winfs": "sd_card0\\sim",
              "packagePath": "data\\sim"
            },
            {
              "packagePath": "data\\chklist.ace",
              "winfs": "sd_card0\\chklist.ace"
            },
            {
              "packagePath": "data\\user.wpt",
              "winfs": "sd_card0\\user.wpt"
            }
          ]
        }
      }
    ],
    "StartingUserData": [
      {
        "Transform": {
          "copy": [
            {
              "packagePath": "data\\reg_files\\$(Airframe)",
              "winfsPath": "emmc0",
              "globs": [
                "**"
              ]
            }
          ]
        }
      }
    ],
    "Databases": {
      "BASEMAP": "emmc0/db/active/BMAP.BIN",
      "JEPP_NAV": "emmc0/db/active/nav_db2.bin",
      "GARMIN_NAV": "emmc0/db/active/nav_db2.bin",
      "TERRAIN": "emmc0/db/active/trn.dat",
      "FIXED_OBSTACLE": "emmc0/db/active/standard.odb",
      "ROTOR_OBSTACLE": "emmc0/db/active/standard.odb",
      "SAFETAXI": "emmc0/db/active/safetaxi.bin",
      "FLITECHARTS": "emmc0/db/active/fc_tpc"
    }
  },
  "HelpResources": {
    "Manuals": [
      {
        "source": "manuals/GTN Xi Series Pilot's Guide.pdf",
        "displayName": "Pilot's Guide",
        "description": "Detailed instructions for all features and procedures."
