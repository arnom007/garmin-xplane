  "DataFormats": {
    "DataRouterClientVersion": "19.5.2.0",
    "Instances": {
      "all": {
        "HSDB": 4,
        "IN": {
          "GENERIC": {
            "0": "RDMP"
          }
        },
        "OUT": {
          "GENERIC": {
            "0": "RDMP"
          }
        }
      }
    }
  },
  "Winfs": {
    "Essentials": [
      {
        "Transform": {
          "links": [
            {
              "winfs": "resource_files.gca",
              "packagePath": "data\\resource_files.gca"
            },
            {
              "winfs": "sim",
              "packagePath": "data\\sim"
            },
            {
              "winfs": "aircraft_cfg",
              "packagePath": "data\\aircraft_cfg"
            }
          ],
          "copy": [
            {
              "packagePath": "data\\reg_files\\$(Models)\\$(Airframe)\\",
              "winfsPath": "nonvol\\emmc0",
              "globs": [
                "reg_sys_cnfg*.reg"
              ]
            }
          ]
        }
      }
    ],
    "StartingUserData": [
      {
        "Transform": {
          "copy": [
            {
              "packagePath": "data\\reg_files\\pilot_profile",
              "winfsPath": "nonvol\\emmc0\\usr\\Default",
              "globs": [
                "**"
              ]
            },
            {
              "packagePath": "data\\reg_files\\$(Models)\\$(Airframe)",
              "winfsPath": "nonvol\\emmc0",
              "globs": [
                "**"
              ]
            },
            {
              "packagePath": "data\\sim\\eis\\scenario\\1",
              "winfsPath": "nonvol\\sd_card0\\scenario\\1",
              "globs": [
                "**"
              ]
            }
          ]
        }
      }
    ],
    "Databases": {
      "BASEMAP": "BMAP.BIN",
      "JEPP_NAV": "nav_db2.bin",
      "GARMIN_NAV": "nav_db2.bin",
      "TERRAIN": "trn.dat",
      "FIXED_OBSTACLE": "standard.odb",
      "ROTOR_OBSTACLE": "standard.odb",
      "SAFETAXI": "safetaxi.bin",
      "FLITECHARTS": "fc_tpc",
      "AIRPORT_DIRECTORY": "apt_dir.gca"
    }
  },
